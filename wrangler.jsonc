// Cloudflare Workers settings: serve the built site (dist/) as static files.
// Build command on Cloudflare: pip install pillow && python scripts/dist.py
{
  "name": "adela-prive",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
